# Long-lived cache for hashed Vite build outputs (filename includes content hash).
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# HTML shell — always revalidate so deploys propagate quickly.
/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

# Service worker must never be cached aggressively.
/sw.js
  Cache-Control: public, max-age=0, must-revalidate
