{
  "name": "song-an-40",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --pretty false",
    "lint": "oxlint worker client shared tests",
    "lint:fix": "prettier --check \"**/*.{ts,tsx,js,json,css,md,jsonc}\"",
    "format": "prettier --write \"**/*.{ts,tsx,js,json,css,md,jsonc}\"",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "db:migrate:local": "wrangler d1 migrations apply song-an-40-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply song-an-40-db --remote",
    "db:seed:local": "wrangler d1 execute song-an-40-db --local --file=./seed/demo.sql",
    "seed:generate": "node seed/generate-production-scale.mjs",
    "db:seed:scale": "pnpm seed:generate && wrangler d1 execute song-an-40-db --local --file=./seed/production-scale.sql",
    "qa:inventory": "playwright test tests/e2e/inventory.spec.ts",
    "cf:types": "wrangler types",
    "cf:check": "wrangler deploy --dry-run",
    "cf:dev": "vite",
    "deploy:dry-run": "pnpm build && wrangler deploy --dry-run"
  },
  "dependencies": {
    "clsx": "^2.1.1",
    "drizzle-orm": "^0.45.2",
    "hono": "^4.13.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@cloudflare/vite-plugin": "^1.50.0",
    "@cloudflare/vitest-pool-workers": "^0.20.1",
    "@cloudflare/workers-types": "^5.20260804.1",
    "@playwright/test": "^1.62.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "oxlint": "^1.75.0",
    "prettier": "^3.9.6",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.3",
    "vite": "^8.2.0",
    "vitest": "^4.1.10",
    "wrangler": "^4.118.0"
  }
}
