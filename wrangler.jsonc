{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "song-an-40",
  "main": "./worker/index.ts",
  "compatibility_date": "2026-08-04",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "not_found_handling": "single-page-application",
    "binding": "ASSETS",
    // API + crawl surfaces must hit the Worker before static SPA assets.
    // /admin is an SPA route; protect it with Cloudflare Access in staging/production.
    "run_worker_first": [
      "/api/*",
      "/sitemap.xml",
      "/robots.txt",
      "/feed.xml"
    ]
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "ENVIRONMENT": "staging",
    "APP_NAME": "Sống An 40+",
    "AI_SEARCH_INSTANCE": "song-an-40-knowledge",
    "AI_GATEWAY_ID": "song-an-40",
    "SESSION_COOKIE_NAME": "sa_session",
    "CSRF_COOKIE_NAME": "sa_csrf",
    "TURNSTILE_SITE_KEY": "",
    "FEATURE_CHAT_HISTORY_DEFAULT": "false",
    "PROMPT_VERSION": "v1.0.0",
    "SCORING_RULESET_VERSION": "v1.0.1",
    "SAFETY_RULESET_VERSION": "v1.0.0",
    "PLAN_RULESET_VERSION": "v1.0.1",
    // Local/staging QA only. Leave empty in production — use Cloudflare Access.
    "LOCAL_QA_ADMIN_TOKEN": "",
    "PUBLIC_SITE_URL": "https://song-an-40.sycu-lee.workers.dev"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "song-an-40-db",
      "database_id": "a4b402a1-ca02-466a-8ca9-40730c11660f",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "SOURCES",
      "bucket_name": "song-an-40-sources"
    }
  ],
  "kv_namespaces": [
    {
      "binding": "CONFIG",
      "id": "34c4ed037b34402298c8277584f48e9c"
    }
  ],
  "ai": {
    "binding": "AI"
  },
  "ai_search_namespaces": [
    {
      "binding": "AI_SEARCH",
      "namespace": "default"
      // Set "remote": true when authenticated to proxy a deployed AI Search instance.
      // Local development uses D1 chunk fallback when AI Search is unavailable.
    }
  ],
  "queues": {
    "producers": [
      {
        "binding": "INGESTION_QUEUE",
        "queue": "song-an-40-ingestion"
      },
      {
        "binding": "ANALYTICS_QUEUE",
        "queue": "song-an-40-analytics"
      }
    ],
    "consumers": [
      {
        "queue": "song-an-40-ingestion",
        "max_batch_size": 5,
        "max_batch_timeout": 30,
        "max_retries": 5,
        "dead_letter_queue": "song-an-40-ingestion-dlq"
      },
      {
        "queue": "song-an-40-analytics",
        "max_batch_size": 20,
        "max_batch_timeout": 60,
        "max_retries": 3
      }
    ]
  },
  "workflows": [
    {
      "binding": "INGESTION_WORKFLOW",
      "name": "song-an-40-ingestion",
      "class_name": "IngestionWorkflow"
    }
  ],
  // Daily: publish due posts + fill schedule horizon (1 bài/ngày) for crawlable blog.
  "triggers": {
    "crons": ["0 2 * * *"]
  },
  "env": {
    "staging": {
      "name": "song-an-40-staging",
      "vars": {
        "ENVIRONMENT": "staging",
        "APP_NAME": "Sống An 40+",
        "AI_SEARCH_INSTANCE": "song-an-40-knowledge",
        "AI_GATEWAY_ID": "song-an-40",
        "SESSION_COOKIE_NAME": "sa_session",
        "CSRF_COOKIE_NAME": "sa_csrf",
        "FEATURE_CHAT_HISTORY_DEFAULT": "false",
        "PROMPT_VERSION": "v1.0.0",
        "SCORING_RULESET_VERSION": "v1.0.1",
        "SAFETY_RULESET_VERSION": "v1.0.0",
        "PLAN_RULESET_VERSION": "v1.0.1",
        "PUBLIC_SITE_URL": "https://song-an-40.sycu-lee.workers.dev"
      }
    }
  }
}
